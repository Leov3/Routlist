DATABASE_URL="postgresql://routlis:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/routlis?schema=public"

JWT_SECRET="CHANGE_ME_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="1d"

COOKIE_NAME="routlis_token"
COOKIE_SECURE="true"

STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="/var/www/routlis/storage"
LOCAL_AUDIO_PATH="/var/www/routlis/storage/audio-assets"
PUBLIC_AUDIO_BASE_URL="https://api.tu-dominio.com/files/audio-assets"

FRONTEND_URL="https://tu-dominio.com"
CORS_ORIGINS="https://tu-dominio.com"
PORT="4000"
SEED_ADMIN_PASSWORD="CHANGE_ME_INITIAL_ADMIN_PASSWORD"
